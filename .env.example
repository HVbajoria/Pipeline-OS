# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Durable persistence (Cloud Firestore) ---
# The server is the authoritative writer of Shared_State, the idempotency
# ledger, and web sessions. In production these must survive a restart and be
# shared across instances, so they are backed by Cloud Firestore through the
# Firebase Admin SDK (a service account) -- NOT the browser/web Firebase config.
#
# When credentials are available (or PERSISTENCE_BACKEND=firestore) the server
# automatically swaps the in-memory demo stores for Firestore-backed ones and
# hydrates from the last persisted snapshot at startup. With no credentials it
# keeps the deterministic in-memory demo behavior.
#
# Backend selection:
#   PERSISTENCE_BACKEND=firestore   -> force durable Firestore persistence
#   PERSISTENCE_BACKEND=memory      -> force in-memory (demo/tests), ignore creds
#   (unset)                         -> auto: Firestore when credentials exist
# PERSISTENCE_BACKEND="firestore"

# Firestore project id. Defaults to the PipelineOS project when unset.
# FIREBASE_PROJECT_ID="pipelineos-d8a4e"

# Credential resolution (first match wins):
#   1. FIREBASE_SERVICE_ACCOUNT       - inline service-account key JSON, or a
#                                       path to a service-account key file.
#   2. GOOGLE_APPLICATION_CREDENTIALS - path to a service-account key file
#                                       (Application Default Credentials).
#   3. Application Default Credentials - e.g. the Cloud Run / GCE metadata
#                                       server (recommended in production; no
#                                       key files needed).
# FIREBASE_SERVICE_ACCOUNT=""
# GOOGLE_APPLICATION_CREDENTIALS="/secrets/pipelineos-sa.json"

# Browser (web) Firebase config for the frontend. Safe to expose publicly.
# These are NOT used by server persistence; they are only for client-side
# Firebase features if you add them later.
# FIREBASE_API_KEY="AIzaSyBkdJQ4cJGkvk6sGPdpkHPlaQveilaMDlI"
# FIREBASE_AUTH_DOMAIN="pipelineos-d8a4e.firebaseapp.com"
# FIREBASE_STORAGE_BUCKET="pipelineos-d8a4e.firebasestorage.app"
# FIREBASE_MESSAGING_SENDER_ID="169176032443"
# FIREBASE_APP_ID="1:169176032443:web:416308749407ea5b56f59e"

# --- Abuse protection & transport safety ---
# These harden the public /api/* and /mcp surfaces (an LLM host such as a
# ChatGPT connector autonomously calls tools, so the transport defends itself).
# All have safe defaults and can also be set programmatically via the
# `security` option on createPipelineApi/startServer.

# Max JSON request body size (default 256kb).
# REQUEST_BODY_LIMIT="256kb"

# Comma-separated CORS origin allowlist. Same-origin needs no entry; requests
# with no Origin header (server-to-server, curl) are always allowed.
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# Rate limiting (per resolved principal, falling back to client IP), applied to
# /api and /mcp. Window in ms and max requests per key per window.
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="120"
# Set to true to disable rate limiting entirely (e.g. for local load testing).
# RATE_LIMIT_DISABLED="false"

# Wall-clock timeout (ms) for a single operation execution. Because operations
# are serialized, a hung handler would otherwise block the queue. Default
# 20000; set 0 to disable. Configured via the operationService option
# operationTimeoutMs rather than an env var by default.

# --- Observability & operations ---
# Structured logging level (pino): trace|debug|info|warn|error|fatal|silent.
# Defaults to debug in development, info in production, silent in tests.
# LOG_LEVEL="info"

# Prometheus metrics are exposed at GET /metrics by default. Set to false to
# disable the endpoint (the registry still runs internally).
# METRICS_ENABLED="true"

# Scheduled maintenance sweep interval in ms (expires overdue approval cards,
# prunes expired idempotency-ledger entries, applies public-prospect
# retention). Default 300000 (5 minutes).
# MAINTENANCE_INTERVAL_MS="300000"

# Operational endpoints (unauthenticated, not rate limited):
#   GET /health   - liveness (always 200 while the process is up)
#   GET /ready    - readiness (503 if the authoritative store is unreadable)
#   GET /metrics  - Prometheus text exposition (operation latency, error rates
#                   by code, MCP tool-call volume, process gauges)

# Optional server-only GitHub token for public-prospect rate-limit headroom.
# Never expose this value to browser code or commit a real token.
# GITHUB_TOKEN=""
# GITHUB_PROSPECT_MAX_RESULTS="10"
# GITHUB_PROSPECT_CACHE_TTL_MS="300000"

# Remote MCP endpoint.
# The server exposes all 32 canonical operations as MCP tools at POST /mcp
# (Streamable HTTP), so a ChatGPT connector or other MCP client can list and
# call them. The endpoint is mounted by default; disable it via the
# `enableMcpEndpoint: false` PipelineApiOptions flag if you do not need it.
#
# Trust boundary: when NODE_ENV=production, arbitrary x-actor-* headers are
# ignored and every tools/call fails closed with FORBIDDEN_ERROR unless the
# composition root supplies a trusted host resolver (resolveTrustedPrincipal)
# that maps the authenticated connector user to a TrustedPrincipal. Discovery
# (initialize, tools/list) does not require a trusted principal; execution does.

# --- Authentication and multi-tenancy ---
# Real auth is wired through an `authProvider` passed to startServer/createPipelineApi
# (see src/server/auth/ and the README "Authentication and multi-tenancy" section).
# These variables are the typical host configuration a composition root reads
# when building that provider. They are illustrative; the code accepts the
# values through the authProvider option rather than reading them directly.

# Web OIDC login (browser recruiters/candidates/hiring managers)
# OIDC_ISSUER_URL="https://auth.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="https://pipelineos.example.com/auth/callback"
# Secret used to sign the session cookie. Use a long random value in production.
# SESSION_SECRET=""

# MCP OAuth (ChatGPT and other agent connectors)
# The public URL of the MCP resource, advertised in the protected-resource metadata.
# MCP_RESOURCE_URL="https://pipelineos.example.com/mcp"
# One or more authorization server issuer URLs a connector may use.
# MCP_AUTHORIZATION_SERVERS="https://auth.example.com"

# Multi-tenancy: tenant is carried on the verified identity claims (e.g. a
# `tenant` or `org` claim on the OIDC token). No separate env var is required;
# ensure your IdP emits a tenant claim so scopes are tenant-stamped.
