{
  "name": "pipelineos",
  "version": "1.0.0",
  "private": true,
  "description": "PipelineOS — a WebMCP/MCP-native recruiting platform where humans and agents drive the same hiring workflow through one operation path.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "2.19.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "pino": "9.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-joyride": "3.2.0",
    "react-router-dom": "7.18.3",
    "uuid": "14.0.2",
    "vite": "6.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/uuid": "10.0.0",
    "autoprefixer": "10.5.4",
    "esbuild": "0.25.12",
    "fast-check": "4.3.0",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
